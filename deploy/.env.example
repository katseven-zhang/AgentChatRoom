# Copy this file to deploy/.env and replace every placeholder.
# Do not commit deploy/.env. Password characters in the URL must be URL-encoded.
POSTGRES_DB=agentchatroom
POSTGRES_USER=agentchatroom
POSTGRES_PASSWORD=replace-with-a-long-random-password
AGENTCHATROOM_DATABASE_URL=postgresql://agentchatroom:replace-with-a-long-random-password@postgres:5432/agentchatroom
AGENTCHATROOM_ADMIN_TOKEN=replace-with-at-least-24-random-characters
AGENTCHATROOM_EXTERNAL_BASE_URL=https://room.example.com
AGENTCHATROOM_BIND_PORT=8765
